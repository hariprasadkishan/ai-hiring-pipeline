# ==============================================================================
# Project 7: End-to-End AI Hiring Pipeline — Environment Configuration Template
# ==============================================================================

# Database Connection (MySQL 8.0)
# Inside Docker containers, use '@mysql:3306'. For host execution, use '@localhost:3306'.
DATABASE_URL=mysql+pymysql://root:rootpassword@mysql:3306/admission_db

# Security & JWT Authentication
SECRET_KEY=replace_with_a_secure_random_hex_key_at_least_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Institutional / Enterprise Recruiter Domain
# Users registering as 'teacher' / recruiter must possess an email ending in this domain.
RECRUITER_EMAIL_DOMAIN=iiitdwd.ac.in

# OpenRouter AI LLM Integration
# Obtain API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
# Recommended production models:
# OPENROUTER_MODEL=google/gemini-2.0-flash-001
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Cloudinary Storage (Document & Resume Storage)
# Obtain credentials from Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Environment Variable (Place in frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000

